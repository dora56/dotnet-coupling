{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://raw.githubusercontent.com/dora56/dotnet-coupling/main/schemas/dotnet-coupling-config-0.2.schema.json",
  "title": "dotnet-coupling configuration",
  "type": "object",
  "properties": {
    "$schema": {
      "type": "string"
    },
    "analysis": {
      "type": "object",
      "properties": {
        "exclude": {
          "type": "array",
          "items": {
            "type": "string",
            "minLength": 1
          }
        },
        "testProjects": {
          "type": "array",
          "description": "Path patterns for test projects. Couplings whose source file matches these patterns are kept in observed coupling data but excluded from active issue detection.",
          "items": {
            "type": "string",
            "minLength": 1
          }
        }
      },
      "additionalProperties": false
    },
    "thresholds": {
      "type": "object",
      "properties": {
        "maxDependencies": {
          "type": "integer",
          "minimum": 1
        },
        "maxDependents": {
          "type": "integer",
          "minimum": 1
        },
        "minTemporalCoupling": {
          "type": "integer",
          "minimum": 1
        },
        "maxTemporalFilesPerCommit": {
          "type": "integer",
          "minimum": 1
        },
        "scatteredExternalBreadth": {
          "type": "integer",
          "minimum": 1
        }
      },
      "additionalProperties": false
    },
    "ignore": {
      "type": "object",
      "properties": {
        "paths": {
          "type": "array",
          "items": {
            "type": "string",
            "minLength": 1
          }
        },
        "namespaces": {
          "type": "array",
          "items": {
            "type": "string",
            "minLength": 1
          }
        },
        "issueTypes": {
          "type": "array",
          "items": {
            "enum": [
              "GlobalComplexity",
              "CascadingChangeRisk",
              "InappropriateIntimacy",
              "HighEfferentCoupling",
              "HighAfferentCoupling",
              "CircularDependency",
              "HiddenCoupling",
              "AccidentalVolatility",
              "ScatteredExternalCoupling"
            ]
          }
        },
        "issues": {
          "type": "array",
          "items": {
            "type": "object",
            "required": [
              "type",
              "source",
              "target",
              "reason"
            ],
            "properties": {
              "type": {
                "enum": [
                  "GlobalComplexity",
                  "CascadingChangeRisk",
                  "InappropriateIntimacy",
                  "HighEfferentCoupling",
                  "HighAfferentCoupling",
                  "CircularDependency",
                  "HiddenCoupling",
                  "AccidentalVolatility",
                  "ScatteredExternalCoupling"
                ]
              },
              "source": {
                "type": "string",
                "minLength": 1
              },
              "target": {
                "type": "string",
                "minLength": 1
              },
              "reason": {
                "type": "string",
                "minLength": 1
              }
            },
            "additionalProperties": false
          }
        }
      },
      "additionalProperties": false
    },
    "domain": {
      "type": "object",
      "properties": {
        "subdomains": {
          "type": "array",
          "description": "Subdomain entries are evaluated in order; the first matching path pattern wins. Names must be unique, case-insensitively.",
          "items": {
            "type": "object",
            "required": [
              "name",
              "category",
              "paths",
              "expectedVolatility"
            ],
            "properties": {
              "name": {
                "type": "string",
                "description": "Unique subdomain name. Case-only duplicates are rejected.",
                "minLength": 1
              },
              "category": {
                "enum": [
                  "core",
                  "supporting",
                  "generic",
                  "Core",
                  "Supporting",
                  "Generic"
                ]
              },
              "paths": {
                "type": "array",
                "description": "Repository/workspace-relative path patterns. The config file location and --config path do not change their meaning.",
                "minItems": 1,
                "items": {
                  "type": "string",
                  "minLength": 1
                }
              },
              "expectedVolatility": {
                "enum": [
                  "low",
                  "medium",
                  "high",
                  "Low",
                  "Medium",
                  "High"
                ]
              },
              "strategicRole": {
                "enum": [
                  "anticorruptionLayer",
                  "publishedLanguage",
                  "sharedKernel",
                  "openHostService",
                  "AnticorruptionLayer",
                  "PublishedLanguage",
                  "SharedKernel",
                  "OpenHostService"
                ]
              }
            },
            "additionalProperties": false
          }
        },
        "areas": {
          "type": "array",
          "description": "Technical role areas are evaluated in order; the first matching path pattern wins. Names must be unique, case-insensitively.",
          "items": {
            "type": "object",
            "required": [
              "name",
              "paths",
              "technicalRole"
            ],
            "properties": {
              "name": {
                "type": "string",
                "description": "Unique technical area name. Case-only duplicates are rejected.",
                "minLength": 1
              },
              "paths": {
                "type": "array",
                "description": "Repository/workspace-relative path patterns. The config file location and --config path do not change their meaning.",
                "minItems": 1,
                "items": {
                  "type": "string",
                  "minLength": 1
                }
              },
              "technicalRole": {
                "enum": [
                  "domainModel",
                  "applicationService",
                  "adapter",
                  "compositionRoot",
                  "contract",
                  "testSupport",
                  "DomainModel",
                  "ApplicationService",
                  "Adapter",
                  "CompositionRoot",
                  "Contract",
                  "TestSupport"
                ]
              }
            },
            "additionalProperties": false
          }
        }
      },
      "additionalProperties": false
    }
  },
  "additionalProperties": false
}
