{
  "$schema": "schemas/dotnet-coupling-config-0.2.schema.json",
  "analysis": {
    "exclude": [
      "**/Generated/**",
      "**/*.g.cs",
      "**/*.generated.cs"
    ],
    "testProjects": [
      "**/tests/**"
    ]
  },
  "thresholds": {
    "maxDependencies": 20,
    "maxDependents": 30,
    "minTemporalCoupling": 3,
    "maxTemporalFilesPerCommit": 50,
    "scatteredExternalBreadth": 5
  },
  "prioritization": {
    "cyclomaticComplexityThreshold": 10,
    "cognitiveComplexityThreshold": 15,
    "complexityWeight": 0.1
  },
  "ignore": {
    "paths": [
      "**/Legacy/**"
    ],
    "namespaces": [
      "Sample.Legacy"
    ],
    "issueTypes": [
      "ScatteredExternalCoupling"
    ],
    "issues": [
      {
        "type": "GlobalComplexity",
        "source": "Sample.App.Api.LegacyHandler",
        "target": "Sample.App.Infrastructure.LegacyRepository",
        "reason": "Accepted legacy dependency tracked in ARCH-42"
      }
    ]
  },
  "domain": {
    "subdomains": [
      {
        "name": "Billing",
        "category": "core",
        "paths": [
          "src/Sample.App.Billing/**"
        ],
        "expectedVolatility": "high"
      },
      {
        "name": "Reporting",
        "category": "supporting",
        "paths": [
          "src/Sample.App.Reporting/**"
        ],
        "expectedVolatility": "low"
      },
      {
        "name": "SharedKernel",
        "category": "supporting",
        "paths": [
          "src/Sample.App.SharedKernel/**"
        ],
        "expectedVolatility": "low",
        "strategicRole": "sharedKernel"
      }
    ],
    "areas": [
      {
        "name": "BillingContracts",
        "paths": [
          "src/Sample.App.Billing/Contracts/**",
          "src/Sample.App.Billing/Domain/**/*Id.cs",
          "src/Sample.App.Billing/Domain/**/*Dto.cs",
          "src/Sample.App.SharedKernel/**"
        ],
        "technicalRole": "contract"
      },
      {
        "name": "BillingDomain",
        "paths": [
          "src/Sample.App.Billing/Domain/**"
        ],
        "technicalRole": "domainModel"
      },
      {
        "name": "BillingApplication",
        "paths": [
          "src/Sample.App.Billing/Application/**"
        ],
        "technicalRole": "applicationService"
      },
      {
        "name": "HostCompositionRoot",
        "paths": [
          "src/Sample.App.Web/Program.cs",
          "src/Sample.App.Web/Startup.cs",
          "src/Sample.App.Web/*Startup.cs",
          "src/Sample.App.Web/Modules/**"
        ],
        "technicalRole": "compositionRoot"
      },
      {
        "name": "InfrastructureAdapters",
        "paths": [
          "src/Sample.App.Infrastructure/**"
        ],
        "technicalRole": "adapter"
      }
    ]
  }
}
