{
  "$schema": "schemas/dotnet-coupling-config-0.2.schema.json",
  "analysis": {
    "exclude": [
      "**/Generated/**",
      "**/*.g.cs",
      "**/*.generated.cs"
    ],
    "testProjects": [
      "**/tests/**"
    ]
  },
  "thresholds": {
    "maxDependencies": 20,
    "maxDependents": 30,
    "minTemporalCoupling": 3,
    "maxTemporalFilesPerCommit": 50,
    "scatteredExternalBreadth": 5
  },
  "ignore": {
    "paths": [
      "**/Legacy/**"
    ],
    "namespaces": [
      "Sample.Legacy"
    ],
    "issueTypes": [
      "ScatteredExternalCoupling"
    ],
    "issues": [
      {
        "type": "GlobalComplexity",
        "source": "Sample.App.Api.LegacyHandler",
        "target": "Sample.App.Infrastructure.LegacyRepository",
        "reason": "Accepted legacy dependency tracked in ARCH-42"
      }
    ]
  },
  "domain": {
    "subdomains": [
      {
        "name": "Billing",
        "category": "core",
        "paths": [
          "src/Sample.App.Billing/**"
        ],
        "expectedVolatility": "high"
      },
      {
        "name": "Reporting",
        "category": "supporting",
        "paths": [
          "src/Sample.App.Reporting/**"
        ],
        "expectedVolatility": "low"
      }
    ]
  }
}
